{
  "name": "dsh-proxy-config",
  "version": "0.4.0",
  "description": "Configure multiple named outbound HTTP proxies (and bypass lists) for DeepSeek Harness from Settings — exactly one active at a time — instead of the launch environment",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "proxy",
    "no_proxy"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node test/proxy-e2e.mjs && node test/client-smoke.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-http-proxy": ">=0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
